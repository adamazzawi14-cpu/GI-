do
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true
	local lastHop = 0
	local leftAir = false
	local lastJump = 0

	local function isWallPart(part, normal, character)
		if not part or not part:IsA("BasePart") or not part.CanCollide then return false end
		if character and part:IsDescendantOf(character) then return false end
		if normal and math.abs(normal.Y) > 0.45 then return false end
		local lower = string.lower(part.Name)
		if string.find(lower, "stair", 1, true) or string.find(lower, "step", 1, true) or string.find(part.Name, "درج", 1, true) then
			return false
		end
		if part:IsA("WedgePart") or part:IsA("TrussPart") then return false end
		return part.Size.Y >= 3
	end

	UserInputService.JumpRequest:Connect(function()
		if not doubleJumpEnabled then return end
		local now = os.clock()
		if now - lastJump < 0.12 then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end
		local st = hum:GetState()
		local onGround = (st == Enum.HumanoidStateType.Running or st == Enum.HumanoidStateType.RunningNoPhysics or st == Enum.HumanoidStateType.Landed)
		if onGround then
			leftAir = false
		elseif leftAir then
			lastJump = now
			local jv = hum.UseJumpPower and math.max(hum.JumpPower, 52) or 52
			local v = hrp.AssemblyLinearVelocity
			hrp.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y * 0.25, jv), v.Z)
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)

	RunService.Heartbeat:Connect(function()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end

		if speedTouched then
			hum.WalkSpeed = currentSpeed
		end

		if doubleJumpEnabled then
			local st = hum:GetState()
			if st == Enum.HumanoidStateType.Landed or st == Enum.HumanoidStateType.Running or st == Enum.HumanoidStateType.RunningNoPhysics then
				leftAir = false
			elseif st == Enum.HumanoidStateType.Freefall then
				leftAir = true
			end
		end

		if noWallEnabled then
			local md = hum.MoveDirection
			local fm = Vector3.new(md.X, 0, md.Z)
			if fm.Magnitude > 0.05 then
				local dir = fm.Unit
				rayParams.FilterDescendantsInstances = { char }
				local hit = workspace:Raycast(hrp.Position, dir * 2.2, rayParams)
				if hit and isWallPart(hit.Instance, hit.Normal, char) then
					local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
					if n.Magnitude > 0.01 then
						n = n.Unit
						local into = dir:Dot(-n)
						if into > 0 then
							local tanDir = dir + (n * into)
							if tanDir.Magnitude > 0.05 then
								tanDir = tanDir.Unit
								local spd = math.max(hum.WalkSpeed, 16)
								local v = hrp.AssemblyLinearVelocity
								hrp.AssemblyLinearVelocity = Vector3.new(tanDir.X * spd, v.Y, tanDir.Z * spd)
							end
						end
					end
				end
			end
		end

		if wallHopEnabled then
			local now = os.clock()
			if now - lastHop >= 0.24 then
				local look = hrp.CFrame.LookVector
				local cDir = Vector3.new(look.X, 0, look.Z)
				if cDir.Magnitude > 0.01 then
					cDir = cDir.Unit
					rayParams.FilterDescendantsInstances = { char }
					local hit = workspace:Raycast(hrp.Position, cDir * 2.1, rayParams)
					if hit and isWallPart(hit.Instance, hit.Normal, char) then
						local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
						if n.Magnitude > 0.01 then
							n = n.Unit
							lastHop = now
							hum:ChangeState(Enum.HumanoidStateType.Jumping)
							hum.Jump = true
							local spd = math.max(hum.WalkSpeed, 18)
							local v = hrp.AssemblyLinearVelocity
							hrp.AssemblyLinearVelocity = Vector3.new(n.X * spd, math.max(v.Y, 44), n.Z * spd)
						end
					end
				end
			end
		end

		if assistMenuEnabled and assistActive then
			local bestPlr, bestRoot, bestHum, bestDist = nil, nil, nil, math.huge
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					local r = plr.Character:FindFirstChild("HumanoidRootPart")
					local h = plr.Character:FindFirstChildOfClass("Humanoid")
					if r and h and h.Health > 0 then
						local d = (r.Position - hrp.Position).Magnitude
						if d <= rangeValue and d < bestDist then
							bestDist = d
							bestPlr = plr
							bestRoot = r
							bestHum = h
						end
					end
				end
			end
			if bestRoot then
				targetStatusLbl.Text = string.format(txt("targetFound"), bestPlr.Name)
				local backDir = -bestRoot.CFrame.LookVector
				local flatBack = Vector3.new(backDir.X, 0, backDir.Z)
				flatBack = flatBack.Magnitude > 0.01 and flatBack.Unit or Vector3.new(0, 0, 1)
				local goal = bestRoot.Position + (flatBack * gapValue)
				if (Vector3.new(goal.X, hrp.Position.Y, goal.Z) - Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)).Magnitude > 1.2 then
					hum:MoveTo(Vector3.new(goal.X, hrp.Position.Y, goal.Z))
				end
				if (bestRoot.Position.Y - hrp.Position.Y > 3.2) or (bestHum and bestHum:GetState() == Enum.HumanoidStateType.Jumping) then
					hum.Jump = true
				end
			else
				targetStatusLbl.Text = txt("targetNone")
			end
		end
	end)
end

