local function switchTab(name)
	for pName, page in pairs(pages) do
		page.Visible = (pName == name)
	end
	for tName, btn in pairs(tabBtns) do
		local selected = (tName == name)
		btn.BackgroundColor3 = selected and Color3.fromRGB(0, 145, 255) or Color3.fromRGB(25, 33, 52)
		btn.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(190, 206, 232)
	end
end

