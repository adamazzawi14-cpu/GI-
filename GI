local dashCreated = false
local dashState = false
local dashFloatingBtn = nil
local dashFloatingStroke = nil
local dashIsRunning = false
local dashActiveBv = nil

local function syncDashFloatVisuals()
	if not dashFloatingBtn then return end
	dashFloatingBtn.Visible = dashState
	dashFloatingBtn.Text = dashIsRunning and txt("dashOn") or txt("dashOff")
	paintGreen(dashFloatingBtn, dashFloatingStroke, dashIsRunning)
end

local function stopDashMotion()
	dashIsRunning = false
	if dashActiveBv and dashActiveBv.Parent then
		pcall(function() dashActiveBv:Destroy() end)
	end
	dashActiveBv = nil
	syncDashFloatVisuals()
end

bindClick(dashSpawnBtn, function()
	dashState = not dashState
	paintGreen(dashSpawnBtn, dashSpawnStroke, dashState)

	if not dashState then
		stopDashMotion()
		if dashFloatingBtn then
			dashFloatingBtn.Visible = false
		end
		return
	end

	if not dashCreated then
		dashCreated = true
		pcall(function()
			local power = 15
			local stepTime = 0.12

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(0, 120, 0, 34)
			btn.AnchorPoint = Vector2.new(0.5, 0.5)
			btn.Position = UDim2.new(0.5, 0, 0.78, 0)
			btn.BackgroundColor3 = Color3.fromRGB(25, 34, 54)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Text = txt("dashOff")
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = 12
			btn.AutoButtonColor = false
			btn.ZIndex = 90
			btn.Parent = gui
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

			local fStroke = Instance.new("UIStroke")
			fStroke.Color = Color3.fromRGB(135, 225, 255)
			fStroke.Thickness = 1.2
			fStroke.Parent = btn

			dashFloatingBtn = btn
			dashFloatingStroke = fStroke

			makeDraggable(btn, function()
				if not dashState then return end
				if dashIsRunning then
					stopDashMotion()
					return
				end
				dashIsRunning = true
				syncDashFloatVisuals()
				task.spawn(function()
					pcall(function()
						local char = player.Character
						local hrp = char and char:FindFirstChild("HumanoidRootPart")
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						if not hrp or not hum or hum.Health <= 0 then return end
						local look = hrp.CFrame.LookVector
						local straightDir = Vector3.new(look.X, 0, look.Z)
						straightDir = straightDir.Magnitude > 0.001 and straightDir.Unit or Vector3.new(0, 0, -1)
						local bv = Instance.new("BodyVelocity")
						bv.MaxForce = Vector3.new(1e5, 0, 1e5)
						bv.P = 1e4
						bv.Velocity = Vector3.zero
						bv.Parent = hrp
						dashActiveBv = bv
						for _ = 1, 20 do
							if not dashState or not dashIsRunning or not bv or not bv.Parent or not hrp or not hrp.Parent or not hum or hum.Health <= 0 then break end
							bv.Velocity = straightDir * power
							task.wait(stepTime)
							if not dashState or not dashIsRunning or not bv or not bv.Parent or not hrp or not hrp.Parent or not hum or hum.Health <= 0 then break end
							bv.Velocity = -straightDir * power
							task.wait(stepTime)
						end
					end)
					stopDashMotion()
				end)
			end)
		end)
	end

	syncDashFloatVisuals()
end)

